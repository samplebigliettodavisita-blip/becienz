    // ============================================================================
    // INTERACTIONS: MOUSE + TOUCH + THROW + PAN INERTIA + ZOOM IMPULSE
    // ============================================================================
    let initialPinchDistance = null;
    let initialPinchScale = 1;

    function setupCanvasInteractions() {
      const container = document.getElementById('canvas-container');

      const handlePointerMove = (clientX, clientY) => {
        if (isPanning) {
          const deltaX = clientX - lastPanClientX;
          const deltaY = clientY - lastPanClientY;
          lastPanClientX = clientX;
          lastPanClientY = clientY;

          panX = clientX - panStartX;
          panY = clientY - panStartY;
          applyTransform();

          // Inject physical G-force inertia into all nodes and wires when panning fast!
          if (Math.hypot(deltaX, deltaY) > 2) {
            applyPanInertiaImpulse(deltaX, deltaY);
          }
          return;
        }

        if (dragTarget) {
          const dxScreen = clientX - dragTarget.startClientX;
          const dyScreen = clientY - dragTarget.startClientY;
          if (Math.abs(dxScreen) > 3 || Math.abs(dyScreen) > 3) {
            dragTarget.hasMoved = true;
          }

          const rect = container.getBoundingClientRect();
          const worldX = (clientX - rect.left - panX) / scale;
          const worldY = (clientY - rect.top - panY) / scale;

          const instVx = worldX - dragTarget.lastWorldX;
          const instVy = worldY - dragTarget.lastWorldY;
          dragTarget.lastWorldX = worldX;
          dragTarget.lastWorldY = worldY;

          if (dragTarget.type === 'lecture') {
            const lec = lecturesData.find(l => l.id === dragTarget.lecId);
            if (lec) {
              lec.x = worldX + dragTarget.grabOffsetX;
              lec.y = worldY + dragTarget.grabOffsetY;
              lec.restX = lec.x;
              lec.restY = lec.y;
              lec.vx = lec.vx * 0.4 + instVx * 0.6;
              lec.vy = lec.vy * 0.4 + instVy * 0.6;

              if (!physicsEnabled) {
                const lecEl = domLectureNodes[lec.id];
                if (lecEl) {
                  lecEl.style.left = `${lec.x - 125}px`;
                  lecEl.style.top = `${lec.y - 45}px`;
                }
              }
            }
          } else if (dragTarget.type === 'branch') {
            const lec = lecturesData.find(l => l.id === dragTarget.lecId);
            const br = lec?.branches[dragTarget.bIdx];
            if (br) {
              br.bx = worldX + dragTarget.grabOffsetX;
              br.by = worldY + dragTarget.grabOffsetY;
              br.offX = br.bx - lec.x;
              br.offY = br.by - lec.y;
              br.vx = br.vx * 0.4 + instVx * 0.6;
              br.vy = br.vy * 0.4 + instVy * 0.6;

              if (!physicsEnabled) {
                const bEl = domBranchNodes[`${lec.id}-${dragTarget.bIdx}`];
                if (bEl) {
                  bEl.style.left = `${br.bx - 115}px`;
                  bEl.style.top = `${br.by - 20}px`;
                }
              }
            }
          }
        }
      };

      const handlePointerUp = () => {
        if (isPanning) {
          isPanning = false;
          container.classList.remove('panning');
        }
        if (dragTarget) {
          if (!dragTarget.hasMoved && dragTarget.type === 'lecture') {
            selectLecture(dragTarget.lecId, false);
          } else if (dragTarget.hasMoved) {
            if (physicsEnabled) {
              if (dragTarget.type === 'lecture') {
                const lec = lecturesData.find(l => l.id === dragTarget.lecId);
                if (lec) {
                  const throwVx = Math.max(-45, Math.min(45, lec.vx));
                  const throwVy = Math.max(-45, Math.min(45, lec.vy));
                  lec.restX = lec.x + throwVx * 8.5;
                  lec.restY = lec.y + throwVy * 8.5;
                  lec.vx = throwVx * 1.35;
                  lec.vy = throwVy * 1.35;
                }
              } else if (dragTarget.type === 'branch') {
                const lec = lecturesData.find(l => l.id === dragTarget.lecId);
                const br = lec?.branches[dragTarget.bIdx];
                if (br) {
                  const throwVx = Math.max(-45, Math.min(45, br.vx));
                  const throwVy = Math.max(-45, Math.min(45, br.vy));
                  let newOffX = (br.bx - lec.x) + throwVx * 7.5;
                  let newOffY = (br.by - lec.y) + throwVy * 7.5;
                  const dist = Math.hypot(newOffX, newOffY);
                  if (dist > 680) {
                    newOffX = (newOffX / dist) * 680;
                    newOffY = (newOffY / dist) * 680;
                  }
                  br.offX = newOffX;
                  br.offY = newOffY;
                  br.vx = throwVx * 1.4;
                  br.vy = throwVy * 1.4;
                }
              }
            }
            saveAllData();
          }
          dragTarget = null;
        }
      };

      container.addEventListener('mousedown', (e) => {
        if (e.target.closest('.draggable-node') || e.target.closest('button') || e.target.isContentEditable) return;
        isPanning = true;
        container.classList.add('panning');
        panStartX = e.clientX - panX;
        panStartY = e.clientY - panY;
        lastPanClientX = e.clientX;
        lastPanClientY = e.clientY;
      });
      window.addEventListener('mousemove', (e) => handlePointerMove(e.clientX, e.clientY));
      window.addEventListener('mouseup', handlePointerUp);

      container.addEventListener('touchstart', (e) => {
        if (e.touches.length === 2) {
          isPanning = false;
          dragTarget = null;
          initialPinchDistance = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          initialPinchScale = scale;
          return;
        }
        if (e.touches.length === 1) {
          if (e.target.closest('.draggable-node') || e.target.closest('button') || e.target.isContentEditable) return;
          isPanning = true;
          panStartX = e.touches[0].clientX - panX;
          panStartY = e.touches[0].clientY - panY;
          lastPanClientX = e.touches[0].clientX;
          lastPanClientY = e.touches[0].clientY;
        }
      }, { passive: false });

      window.addEventListener('touchmove', (e) => {
        if (e.touches.length === 2 && initialPinchDistance) {
          e.preventDefault();
          const newDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          const rect = container.getBoundingClientRect();
          const midX = ((e.touches[0].clientX + e.touches[1].clientX) / 2) - rect.left;
          const midY = ((e.touches[0].clientY + e.touches[1].clientY) / 2) - rect.top;
          const worldX = (midX - panX) / scale;
          const worldY = (midY - panY) / scale;

          const newScale = Math.min(2.2, Math.max(0.25, initialPinchScale * (newDist / initialPinchDistance)));
          const zoomDir = newScale > scale ? 1 : -1;
          applyZoomPhysicsImpulse(zoomDir * 0.45, worldX, worldY);

          panX = midX - worldX * newScale;
          panY = midY - worldY * newScale;
          scale = newScale;
          applyTransform();
          return;
        }
        if (e.touches.length === 1 && (isPanning || dragTarget)) {
          e.preventDefault();
          handlePointerMove(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: false });

      window.addEventListener('touchend', () => {
        initialPinchDistance = null;
        handlePointerUp();
      });

      // Wheel Zoom at Cursor + Physical Radial Response!
      container.addEventListener('wheel', (e) => {
        e.preventDefault();
        const rect = container.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;

        const worldX = (mouseX - panX) / scale;
        const worldY = (mouseY - panY) / scale;

        const isZoomIn = e.deltaY < 0;
        const zoomFactor = isZoomIn ? 1.12 : 0.89;
        const newScale = Math.min(2.2, Math.max(0.25, scale * zoomFactor));

        // Trigger physical push outward on Zoom In, and pull inward on Zoom Out!
        applyZoomPhysicsImpulse(isZoomIn ? 1 : -1, worldX, worldY);

        panX = mouseX - worldX * newScale;
        panY = mouseY - worldY * newScale;
        scale = newScale;

        applyTransform();
      }, { passive: false });
    }

    function zoomAtCenter(factor) {
      const container = document.getElementById('canvas-container');
      const cx = container.clientWidth / 2;
      const cy = container.clientHeight / 2;
      const worldX = (cx - panX) / scale;
      const worldY = (cy - panY) / scale;
      const newScale = Math.min(2.2, Math.max(0.25, scale * factor));
      applyZoomPhysicsImpulse(factor > 1 ? 1 : -1, worldX, worldY);
      panX = cx - worldX * newScale;
      panY = cy - worldY * newScale;
      scale = newScale;
      applyTransform();
    }

    function resetMapView() {
      const container = document.getElementById('canvas-container');
      scale = iphoneMode ? 0.38 : 0.65;
      panX = container.clientWidth / 2 - hubX * scale;
      panY = container.clientHeight / 2 - hubY * scale;
      applyTransform();
    }

    function applyTransform() {
      const world = document.getElementById('map-world');
      world.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
      document.getElementById('zoom-label').textContent = `${Math.round(scale * 100)}%`;
    }

    // ============================================================================
    // ANKI EXPORT & JSON BACKUP
    // ============================================================================
    function generateAnkiExport() {
      const lines = [];
      lecturesData.forEach(lec => {
        lec.branches.forEach(br => {
          const combinedItems = br.items.join('\n• ');
          lines.push(`"${lec.title} — ${br.name}"\t"• ${combinedItems}"`);
        });
      });
      practicalsData.forEach(p => {
        p.preparations.forEach(prep => {
          const allSteps = prep.steps.map(s => `${s.stage}: ${s.detail}`).join('\n');
          lines.push(`"${p.number} (${prep.code} - ${prep.tooth}): Main steps & parameters for ${prep.name}?"\t"${allSteps}"`);
        });
      });
      const out = document.getElementById('anki-output');
      if (out) out.value = lines.join('\n');
    }

    function copyAnkiText() {
      const el = document.getElementById('anki-output');
      el.select();
      document.execCommand('copy');
    }

    function downloadAnkiFile() {
      const text = document.getElementById('anki-output').value;
      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Medical_Psychology_MU_Plovdiv_Anki.txt`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function exportBackupJSON() {
      const payload = {
        ...activeConfig,
        chapters: lecturesData,
        practicals: practicalsData,
        referenceTables: referenceData
      };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Medical_Psychology_v4_Backup.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function resetToDefaults() {
      if (!confirm("Vuoi ripristinare tutti i 17 capitoli, posizioni e protocolli ai valori originali del libro?")) return;
      localStorage.removeItem('medpsych_v4_subject_config');
      localStorage.removeItem(`${storagePrefix}_lectures`);
      localStorage.removeItem(`${storagePrefix}_practicals`);
      location.reload();
    }

    function switchMode(mode) {
      ['map', 'practicals', 'reference', 'anki'].forEach(m => {
        document.getElementById(`view-${m}`).classList.toggle('hidden', m !== mode);
        const btn = document.getElementById(`tab-${m}`);
        if (btn) {
          if (m === mode) {
            btn.className = 'mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-cyan-600 text-white transition';
          } else {
            btn.className = 'mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition';
          }
        }
      });
    }

    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
