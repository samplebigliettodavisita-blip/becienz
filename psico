<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Medical Psychology (MU Plovdiv) — Interactive Physics Atlas v4.0</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap');
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #090d16;
      color: #e2e8f0;
      overflow: hidden;
      touch-action: none;
    }
    .mono { font-family: 'JetBrains Mono', monospace; }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }

    #canvas-container {
      background-color: #090d16;
      background-image: radial-gradient(#1e293b 1.2px, transparent 1.2px);
      background-size: 26px 26px;
      cursor: grab;
      touch-action: none;
    }
    #canvas-container.panning { cursor: grabbing; }

    .draggable-node {
      cursor: grab;
      user-select: none;
      will-change: left, top;
      touch-action: none;
    }
    .draggable-node:active {
      cursor: grabbing;
    }

    [contenteditable="true"] {
      outline: 2px solid #22d3ee !important;
      background-color: rgba(15, 23, 42, 0.95) !important;
      border-radius: 4px;
      padding: 2px 4px;
      cursor: text !important;
      user-select: text !important;
    }

    .editable-hint:hover {
      text-decoration: underline;
      text-decoration-style: dotted;
      text-decoration-color: #38bdf8;
    }

    .sidebar-transition {
      transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
    }

    /* Visual Shockwave Ring on Spacebar */
    @keyframes shockwaveExpand {
      0% {
        transform: translate(-50%, -50%) scale(0.2);
        opacity: 0.9;
        border-width: 8px;
      }
      100% {
        transform: translate(-50%, -50%) scale(4.2);
        opacity: 0;
        border-width: 1px;
      }
    }
    .shockwave-ring {
      position: absolute;
      width: 500px;
      height: 500px;
      border-radius: 9999px;
      border: 4px solid #22d3ee;
      box-shadow: 0 0 40px rgba(34, 211, 238, 0.5), inset 0 0 40px rgba(99, 102, 241, 0.4);
      pointer-events: none;
      z-index: 5;
      animation: shockwaveExpand 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* ==========================================================================
       iPHONE 16 PRO MAX MODE STYLES (440x956 logical viewport + Dynamic Island)
       ========================================================================== */
    body.iphone-framed {
      background: radial-gradient(circle at center, #1e293b 0%, #050811 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px;
    }
    body.iphone-framed #app-shell {
      width: 440px !important;
      height: min(956px, 96vh) !important;
      border-radius: 54px;
      border: 10px solid #27272a;
      box-shadow: 0 0 0 2px #52525b, 0 30px 80px rgba(0,0,0,0.85);
      position: relative;
      overflow: hidden;
      background: #090d16;
    }
    #dynamic-island {
      display: none;
    }
    body.iphone-mode #dynamic-island {
      display: flex;
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      width: 122px;
      height: 32px;
      background: #000000;
      border-radius: 20px;
      z-index: 60;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      border: 1px solid rgba(255,255,255,0.08);
      pointer-events: none;
    }
    body.iphone-mode header {
      padding-top: 46px !important;
      height: 88px !important;
      padding-left: 14px !important;
      padding-right: 14px !important;
    }
    body.iphone-mode .desktop-only {
      display: none !important;
    }
    body.iphone-mode #mobile-bottom-nav {
      display: flex !important;
    }
    body.iphone-mode #left-sidebar,
    body.iphone-mode #right-sidebar {
      position: absolute !important;
      bottom: 64px !important;
      top: 88px !important;
      width: 100% !important;
      z-index: 45 !important;
      background: rgba(9, 13, 22, 0.98) !important;
      backdrop-filter: blur(16px);
    }
    body.iphone-mode #bottom-canvas-toolbar {
      bottom: 74px !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 94% !important;
      justify-content: center !important;
    }
    body.iphone-mode #basket-widget {
      bottom: 130px !important;
      right: 12px !important;
    }
  </style>
</head>
<body class="h-screen w-screen flex flex-col select-none">

  <!-- APP SHELL WRAPPER -->
  <div id="app-shell" class="w-full h-full flex flex-col relative overflow-hidden">

    <!-- DYNAMIC ISLAND (Visible only when iPhone 16 Pro Max Mode is ON) -->
    <div id="dynamic-island">
      <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 animate-pulse"></div>
      <span id="island-label" class="text-[9px] font-bold text-slate-400 tracking-wider mono">PSYCH 4.0</span>
      <div class="w-3 h-3 rounded-full bg-indigo-950 border border-indigo-500/40"></div>
    </div>

    <!-- TOP NAVIGATION BAR -->
    <header class="h-14 bg-slate-900/95 border-b border-slate-800 px-4 flex items-center justify-between z-30 shrink-0 gap-2">
      <!-- Left: Sidebar Toggle + Brand -->
      <div class="flex items-center gap-2">
        <button onclick="toggleLeftSidebar()" id="btn-left-sidebar" title="Mostra/Nascondi Colonna Sinistra"
          class="desktop-only px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-slate-700 text-xs font-semibold flex items-center gap-1.5 transition">
          <span>◧</span> <span class="hidden sm:inline">Capitoli</span>
        </button>

        <div class="flex items-center gap-2">
          <div id="brand-icon" class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 via-purple-600 to-pink-600 flex items-center justify-center font-extrabold text-white shadow text-sm">
            Ψ
          </div>
          <div>
            <h1 class="font-bold text-xs sm:text-sm tracking-tight text-white flex items-center gap-1.5">
              <span id="brand-title">Medical Psychology Atlas</span>
              <span class="desktop-only text-[10px] font-semibold px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                v4.0 • Spacebar Wave + Zoom/Pan Physics
              </span>
            </h1>
          </div>
        </div>
      </div>

      <!-- Center: Desktop Mode Switcher -->
      <div class="desktop-only flex items-center gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800">
        <button onclick="switchMode('map')" id="tab-map" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-cyan-600 text-white transition">
          🕸️ Concept Map
        </button>
        <button onclick="switchMode('practicals')" id="tab-practicals" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">
          🛠️ Protocolli Clinici
        </button>
        <button onclick="switchMode('reference')" id="tab-reference" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">
          📐 Tabelle & Appendici
        </button>
        <button onclick="switchMode('anki')" id="tab-anki" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">
          ⚡ Anki Export
        </button>
      </div>

      <!-- Right: Search + Basketball Trigger + JSON + iPhone 16 Pro Max + Zen + Right Sidebar -->
      <div class="flex items-center gap-1.5">
        <div class="relative hidden 2xl:block">
          <input id="global-search" type="text" oninput="handleSearch(this.value)" placeholder="Cerca SPIKES, malingering, nosognosia..."
            class="w-40 bg-slate-950 border border-slate-800 rounded-lg pl-7 pr-2.5 py-1 text-xs text-slate-200 focus:outline-none focus:border-cyan-500" />
          <span class="absolute left-2 top-1.5 text-slate-500 text-xs">🔍</span>
        </div>

        <!-- BASKETBALL MINIGAME TRIGGER (ON/OFF) -->
        <button onclick="toggleBasketMinigame()" id="btn-basket-toggle" title="Apri/Chiudi Minigioco Fisico Basket Slingshot"
          class="px-2.5 py-1.5 rounded-lg bg-orange-950/80 hover:bg-orange-900 text-orange-300 border border-orange-700/50 text-[11px] font-semibold flex items-center gap-1 transition">
          <span>🏀</span> <span id="basket-toggle-label">Basket: OFF</span>
        </button>

        <button onclick="openSubjectModal()" title="Incolla o Importa una nuova materia in JSON"
          class="desktop-only px-2.5 py-1.5 rounded-lg bg-emerald-950/80 hover:bg-emerald-900 text-emerald-300 border border-emerald-700/50 text-[11px] font-semibold transition">
          📥 JSON
        </button>

        <!-- iPHONE 16 PRO MAX TRIGGER (OFF by default) -->
        <button onclick="toggleIPhoneMode()" id="btn-iphone-mode" title="Attiva/Disattiva Vista Ottimizzata iPhone 16 Pro Max"
          class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-[11px] font-semibold flex items-center gap-1 transition">
          <span>📱</span> <span id="iphone-mode-label">iPhone 16 PM: OFF</span>
        </button>

        <button onclick="toggleIPhoneFrameStyle()" id="btn-iphone-frame" title="Passa tra Cornice Simulatore e Tutto Schermo Mobile"
          class="hidden px-2 py-1.5 rounded-lg bg-purple-950/80 hover:bg-purple-900 text-purple-300 border border-purple-700/50 text-[10px] font-semibold transition">
          🔲 Cornice
        </button>

        <button onclick="toggleZenMode()" title="Modalità Schermo Intero (Chiudi entrambe le barre)"
          class="desktop-only px-2.5 py-1.5 rounded-lg bg-indigo-950/80 hover:bg-indigo-900 text-indigo-300 border border-indigo-700/50 text-xs font-semibold transition">
          ⛶ Zen
        </button>

        <button onclick="toggleRightSidebar()" id="btn-right-sidebar" title="Mostra/Nascondi Pannello Dettagli Destro"
          class="desktop-only px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-slate-700 text-xs font-semibold flex items-center gap-1.5 transition">
          <span class="hidden sm:inline">Inspector</span> <span>◨</span>
        </button>
      </div>
    </header>

    <!-- MAIN WORKSPACE -->
    <div class="flex-1 flex overflow-hidden relative">

      <!-- FLOATING RE-OPEN BUTTONS WHEN SIDEBARS ARE COLLAPSED -->
      <button id="float-open-left" onclick="toggleLeftSidebar()"
        class="desktop-only hidden absolute left-2 top-3 z-30 px-2.5 py-1.5 rounded-lg bg-slate-900/90 hover:bg-slate-800 text-cyan-300 border border-slate-700 text-xs font-bold shadow-xl backdrop-blur">
        ▶ Capitoli
      </button>
      <button id="float-open-right" onclick="toggleRightSidebar()"
        class="desktop-only hidden absolute right-2 top-3 z-30 px-2.5 py-1.5 rounded-lg bg-slate-900/90 hover:bg-slate-800 text-cyan-300 border border-slate-700 text-xs font-bold shadow-xl backdrop-blur">
        ◀ Inspector
      </button>

      <!-- LEFT SIDEBAR: CHAPTERS + ADD NEW CHAPTER -->
      <aside id="left-sidebar" class="bg-slate-900/95 border-r border-slate-800 flex flex-col z-20 shrink-0 sidebar-transition" style="width: 290px;">
        <div class="p-2.5 border-b border-slate-800 flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Capitoli (<span id="progress-badge" class="text-emerald-400">0/17</span>)</span>
          <div class="flex gap-1">
            <button onclick="addNewLecture()" class="text-[10px] px-2 py-0.5 rounded bg-emerald-600 hover:bg-emerald-500 text-white font-bold">+ Capitolo</button>
            <button onclick="filterCluster('all')" class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 hover:bg-slate-700">Tutti</button>
          </div>
        </div>

        <!-- Dynamic Cluster Filters -->
        <div id="cluster-filters" class="px-2.5 py-2 border-b border-slate-800/80 grid grid-cols-2 gap-1 text-[10px]"></div>

        <div id="lecture-list" class="flex-1 overflow-y-auto p-2 space-y-1"></div>

        <!-- Data Management Footer -->
        <div class="p-2 border-t border-slate-800 bg-slate-950/60 flex items-center justify-between gap-1">
          <button onclick="exportBackupJSON()" class="flex-1 py-1 rounded bg-slate-800 hover:bg-slate-700 text-[10px] text-slate-300 font-medium">💾 Backup JSON</button>
          <button onclick="autoArrangeRadial()" class="py-1 px-2 rounded bg-cyan-950/60 hover:bg-cyan-900/80 text-[10px] text-cyan-300 border border-cyan-800/40" title="Riordina i nodi in ellisse">◎ Riordina</button>
          <button onclick="resetToDefaults()" class="py-1 px-2 rounded bg-rose-950/60 hover:bg-rose-900/80 text-[10px] text-rose-300 border border-rose-800/40" title="Ripristina dati originali del libro">↺ Reset</button>
        </div>
      </aside>

      <!-- CENTER VIEWPORT -->
      <main class="flex-1 relative overflow-hidden bg-slate-950">

        <!-- VIEW 1: PHYSICS-ENABLED INTERACTIVE CONCEPT MAP -->
        <div id="view-map" class="w-full h-full relative">
          <div id="canvas-container" class="w-full h-full relative overflow-hidden">
            <div id="map-world" class="absolute top-0 left-0 origin-top-left" style="width: 4200px; height: 3000px;">
              <svg id="map-edges" class="w-full h-full absolute top-0 left-0 pointer-events-none"></svg>
              <div id="map-nodes" class="w-full h-full absolute top-0 left-0"></div>
            </div>
          </div>

          <!-- Floating Bottom Toolbar -->
          <div id="bottom-canvas-toolbar" class="absolute bottom-4 left-4 flex flex-wrap items-center gap-1.5 bg-slate-900/95 backdrop-blur border border-slate-800 p-1.5 rounded-xl shadow-2xl z-20">
            <button onclick="zoomAtCenter(1.18)" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs">+</button>
            <span id="zoom-label" class="text-[11px] mono px-1.5 text-cyan-300 font-bold">65%</span>
            <button onclick="zoomAtCenter(0.85)" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs">−</button>
            <button onclick="resetMapView()" class="px-2 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-300">Centra</button>

            <div class="h-4 w-[1px] bg-slate-700 mx-0.5"></div>

            <!-- PHYSICS CONTROLS -->
            <button onclick="togglePhysicsEngine()" id="btn-physics-toggle" class="px-2.5 h-7 rounded-lg bg-emerald-600/25 border border-emerald-500/50 hover:bg-emerald-600/40 text-[11px] text-emerald-200 font-semibold transition">
              🧲 Fisica: ON
            </button>
            <button onclick="triggerPlayfulImpulse(true)" class="px-2.5 h-7 rounded-lg bg-amber-500/20 border border-amber-500/40 hover:bg-amber-500/35 text-[11px] text-amber-200 font-semibold transition" title="Oppure premi la BARRA SPAZIATRICE!">
              🌊 Onda (Spazio)
            </button>

            <div class="h-4 w-[1px] bg-slate-700 mx-0.5 hidden sm:block"></div>

            <button onclick="toggleAllBranches()" class="px-2 h-7 rounded-lg bg-cyan-600/20 border border-cyan-500/40 hover:bg-cyan-600/40 text-[11px] text-cyan-200 font-medium">
              ± Branch
            </button>
            <button onclick="toggleAllLeafNodes()" class="px-2 h-7 rounded-lg bg-purple-600/20 border border-purple-500/40 hover:bg-purple-600/40 text-[11px] text-purple-200 font-medium">
              ± Dettagli
            </button>
          </div>

          <!-- Helper Banner -->
          <div class="desktop-only absolute top-3 left-1/2 -translate-x-1/2 pointer-events-none bg-slate-900/85 border border-slate-800 px-3.5 py-1 rounded-full text-[11px] text-slate-300 backdrop-blur z-20 hidden lg:block shadow-lg">
            ⌨️ <strong>Barra Spaziatrice</strong>: Onda Elastica • 🔍 <strong>Zoom / Pan Veloce</strong>: Spinta Fisica sui Nodi • 🏀 <strong>Basket</strong>: Minigioco in angolo
          </div>
        </div>

        <!-- VIEW 2: CLINICAL PROTOCOLS & STEP-BY-STEP WORKFLOWS -->
        <div id="view-practicals" class="w-full h-full overflow-y-auto p-4 sm:p-6 pb-24 hidden select-text">
          <div class="max-w-6xl mx-auto space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-900 border border-slate-800 p-5 rounded-2xl">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">Clinical Psychology Protocols • Step-by-Step • Doppio Click per modificare</span>
                <h2 id="practicals-header-title" class="text-xl sm:text-2xl font-extrabold text-white mt-0.5">Protocolli Clinici & Colloquio (2 Procedure per Modulo)</h2>
                <p class="text-xs text-slate-400 mt-1">Anamnesi & Malingering, Intervento in Crisi in 7 Fasi (Roberts), Debriefing, Protocollo SPIKES e Values-Based Practice.</p>
              </div>
              <div class="flex flex-wrap items-center gap-2 shrink-0">
                <button onclick="addNewPractical()" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-xs font-bold text-white">
                  + Nuovo Protocollo
                </button>
                <button onclick="toggleAllPracticalSteps(true)" class="px-3 py-2 rounded-xl bg-cyan-600/20 border border-cyan-500/40 text-xs font-semibold text-cyan-200 hover:bg-cyan-600/30">
                  ➕ Espandi Tutto
                </button>
                <button onclick="toggleAllPracticalSteps(false)" class="px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-xs font-semibold text-slate-300 hover:bg-slate-700">
                  ➖ Chiudi Tutto
                </button>
              </div>
            </div>

            <div id="practical-pills" class="flex flex-wrap gap-2"></div>
            <div id="practicals-container" class="space-y-6"></div>
          </div>
        </div>

        <!-- VIEW 3: DYNAMIC REFERENCE TABLES & APPENDICES -->
        <div id="view-reference" class="w-full h-full overflow-y-auto p-4 sm:p-6 pb-24 hidden select-text">
          <div class="max-w-6xl mx-auto space-y-8" id="reference-container"></div>
        </div>

        <!-- VIEW 4: ANKI EXPORT -->
        <div id="view-anki" class="w-full h-full overflow-y-auto p-4 sm:p-8 pb-24 hidden select-text">
          <div class="max-w-4xl mx-auto space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                <div>
                  <h2 class="text-xl font-bold text-white">Anki Flashcard Exporter (Capitoli 1–17 + Appendici)</h2>
                  <p class="text-xs text-slate-400 mt-1">Sincronizzato in tempo reale con tutti i 17 capitoli, le branch e i protocolli clinici.</p>
                </div>
                <div class="flex gap-2">
                  <button onclick="copyAnkiText()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white border border-slate-700">
                    📋 Copia Tutto
                  </button>
                  <button onclick="downloadAnkiFile()" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-xs font-semibold text-white shadow-lg">
                    ⬇️ Scarica .txt
                  </button>
                </div>
              </div>
              <textarea id="anki-output" readonly class="w-full h-[420px] bg-slate-950 border border-slate-800 rounded-xl p-4 mono text-xs text-slate-300 focus:outline-none"></textarea>
            </div>
          </div>
        </div>

        <!-- ====================================================================
             CORNER BASKETBALL SLINGSHOT MINIGAME WIDGET (TOGGLEABLE ON/OFF)
             ==================================================================== -->
        <div id="basket-widget" class="hidden absolute bottom-4 right-4 w-[310px] bg-slate-900/95 backdrop-blur-xl border-2 border-orange-500/50 rounded-2xl shadow-2xl z-40 overflow-hidden select-none">
          <div class="px-3.5 py-2 bg-gradient-to-r from-orange-600/30 via-amber-600/20 to-slate-900 border-b border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-base">🏀</span>
              <div>
                <div class="text-xs font-extrabold text-white tracking-tight">Hoop Slingshot Physics</div>
                <div class="text-[10px] text-orange-300">Tira indietro la palla e rilascia!</div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="bg-slate-950 px-2.5 py-0.5 rounded-lg border border-orange-500/40 text-right">
                <span class="text-[9px] uppercase text-slate-400 block leading-none">Punti</span>
                <span id="basket-score" class="text-sm font-extrabold text-orange-400 mono">0</span>
              </div>
              <button onclick="toggleBasketMinigame()" class="w-6 h-6 rounded-lg bg-slate-800 hover:bg-rose-900 text-slate-300 hover:text-white text-xs font-bold flex items-center justify-center">✕</button>
            </div>
          </div>
          <div class="relative bg-slate-950 flex items-center justify-center">
            <canvas id="basket-canvas" width="306" height="340" class="cursor-grab active:cursor-grabbing touch-none"></canvas>
            <button onclick="resetBasketBall()" class="absolute bottom-2 left-2.5 px-2 py-0.5 rounded bg-slate-900/90 hover:bg-slate-800 border border-slate-700 text-[10px] text-slate-400">
              ↺ Palla al centro
            </button>
            <div id="basket-streak" class=" absolute bottom-2 right-2.5 text-[10px] font-bold text-amber-400 mono"></div>
          </div>
        </div>

      </main>

      <!-- RIGHT SIDEBAR: INSPECTOR + INTERNAL EDITOR -->
      <aside id="right-sidebar" class="bg-slate-900/95 border-l border-slate-800 flex flex-col z-20 shrink-0 select-text sidebar-transition" style="width: 385px;">
        <div id="inspector-content" class="flex-1 overflow-y-auto p-4 space-y-4 pb-20"></div>
      </aside>

    </div>

    <!-- iOS BOTTOM TAB BAR (Active only in iPhone 16 Pro Max Mode) -->
    <nav id="mobile-bottom-nav" class="hidden h-16 bg-slate-950/95 backdrop-blur-xl border-t border-slate-800 px-2 items-center justify-around z-50 shrink-0 pb-2">
      <button onclick="mobileNavAction('map')" class="flex flex-col items-center gap-0.5 text-[10px] font-semibold text-cyan-400">
        <span class="text-base">🕸️</span><span>Mappa</span>
      </button>
      <button onclick="mobileNavAction('chapters')" class="flex flex-col items-center gap-0.5 text-[10px] font-semibold text-slate-400">
        <span class="text-base">📚</span><span>Capitoli</span>
