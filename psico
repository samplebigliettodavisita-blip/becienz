      lecturesData.forEach(lec => {
        const angle = Math.atan2(lec.y - hubY, lec.x - hubX);
        lec.vx += Math.cos(angle) * 28 + (Math.random() - 0.5) * 14;
        lec.vy += Math.sin(angle) * 28 + (Math.random() - 0.5) * 14;
        lec.branches.forEach((br, idx) => {
          br.vx += Math.cos(angle + idx * 0.5) * 36;
          br.vy += Math.sin(angle + idx * 0.5) * 36;
        });
      });
    }

    // ============================================================================
    // FRONT-FACING BASKETBALL SLINGSHOT MINIGAME (PURE 2.5D PHYSICS, ON/OFF)
    // ============================================================================
    let basketActive = false;
    let basketScore = 0;
    let basketStreak = 0;
    let bBall = {
      x: 153, y: 278, z: 0,
      vx: 0, vy: 0, vz: 0,
      radius: 21,
      state: 'ready', // 'ready' | 'pulling' | 'flying' | 'post_shot'
      pullX: 153, pullY: 278,
      rot: 0, vRot: 0,
