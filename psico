    function assignRadialCoordinatesIfMissing(forceReset = false) {
      const total = lecturesData.length;
      lecturesData.forEach((lec, idx) => {
        if (forceReset || typeof lec.x !== 'number' || typeof lec.y !== 'number') {
          const angle = (idx / Math.max(1, total)) * Math.PI * 2 - Math.PI / 2;
          const radiusX = total > 10 ? 960 : 680;
          const radiusY = total > 10 ? 680 : 480;
          lec.x = Math.round(hubX + Math.cos(angle) * radiusX);
          lec.y = Math.round(hubY + Math.sin(angle) * radiusY);
          lec.restX = lec.x;
          lec.restY = lec.y;
        }
        if (typeof lec.restX !== 'number') lec.restX = lec.x;
        if (typeof lec.restY !== 'number') lec.restY = lec.y;
        lec.vx = lec.vx || 0;
        lec.vy = lec.vy || 0;

        const dir = lec.x < hubX ? -1 : 1;
        lec.branches.forEach((br, bIdx) => {
          const defaultOffX = dir * 280;
          const defaultOffY = (bIdx - (lec.branches.length - 1) / 2) * 84;
          if (forceReset || typeof br.offX !== 'number') {
            br.offX = defaultOffX;
            br.offY = defaultOffY;
          }
          if (forceReset || typeof br.bx !== 'number') {
            br.bx = lec.x + br.offX;
            br.by = lec.y + br.offY;
          }
          br.vx = br.vx || 0;
          br.vy = br.vy || 0;
        });
