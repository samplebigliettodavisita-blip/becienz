    // ============================================================================
    // ZOOM IN / OUT RADIAL PHYSICS & FAST PAN INERTIA IMPULSE
    // ============================================================================
    function applyZoomPhysicsImpulse(zoomDirection, centerWorldX, centerWorldY) {
      if (!physicsEnabled) return;
      // zoomDirection > 0 means Zoom In (push nodes outward as we dive in)
      // zoomDirection < 0 means Zoom Out (pull nodes inward toward center as we pull back)
      lecturesData.forEach(lec => {
        const dx = lec.x - centerWorldX;
        const dy = lec.y - centerWorldY;
        const dist = Math.max(80, Math.hypot(dx, dy));
        const nx = dx / dist;
        const ny = dy / dist;

        const force = zoomDirection * Math.min(24, Math.max(8, dist * 0.022));
        lec.vx += nx * force;
        lec.vy += ny * force;

        lec.branches.forEach(br => {
          const bdx = br.bx - centerWorldX;
          const bdy = br.by - centerWorldY;
          const bdist = Math.max(80, Math.hypot(bdx, bdy));
          br.vx += (bdx / bdist) * force * 1.35;
          br.vy += (bdy / bdist) * force * 1.35;
        });
      });
    }

    function applyPanInertiaImpulse(screenDeltaX, screenDeltaY) {
      if (!physicsEnabled) return;
      // When dragging the canvas fast, nodes & wires experience G-force lag opposite to pan acceleration
      const worldImpulseX = Math.max(-18, Math.min(18, (-screenDeltaX / scale) * 0.22));
      const worldImpulseY = Math.max(-18, Math.min(18, (-screenDeltaY / scale) * 0.22));

      lecturesData.forEach(lec => {
        lec.vx += worldImpulseX * 0.65;
        lec.vy += worldImpulseY * 0.65;
        lec.branches.forEach(br => {
          br.vx += worldImpulseX * 1.15;
          br.vy += worldImpulseY * 1.15;
        });
      });
    }

    // ============================================================================
    // 60FPS SPRING, INERTIA & ELASTIC WIRE PHYSICS ENGINE
    // ============================================================================
    function physicsTick() {
      if (physicsEnabled) {
        lecturesData.forEach(lec => {
          if (activeCluster !== 'all' && lec.cluster !== activeCluster) return;

          const isDraggingThisLec = dragTarget && dragTarget.type === 'lecture' && dragTarget.lecId === lec.id;

          if (!isDraggingThisLec) {
            const dx = lec.restX - lec.x;
            const dy = lec.restY - lec.y;
            const ax = dx * 0.085;
            const ay = dy * 0.085;

            lec.vx = (lec.vx + ax) * 0.82;
            lec.vy = (lec.vy + ay) * 0.82;

            if (Math.abs(lec.vx) > 0.01 || Math.abs(lec.vy) > 0.01 || Math.abs(dx) > 0.1 || Math.abs(dy) > 0.1) {
              lec.x += lec.vx;
              lec.y += lec.vy;
            } else {
              lec.x = lec.restX;
              lec.y = lec.restY;
              lec.vx = 0;
              lec.vy = 0;
            }
          }

          const lecEl = domLectureNodes[lec.id];
          if (lecEl) {
            lecEl.style.left = `${lec.x - 125}px`;
            lecEl.style.top = `${lec.y - 45}px`;
          }

          const hubPath = domHubWirePaths[lec.id];
          if (hubPath) {
            updateElasticWirePath(`hub-${lec.id}`, hubPath, hubX, hubY, lec.x, lec.y, lec.vx, lec.vy, true);
          }

          if (expandedBranches.has(lec.id)) {
            lec.branches.forEach((br, bIdx) => {
              const bKey = `${lec.id}-${bIdx}`;
              const isDraggingThisBranch = dragTarget && dragTarget.type === 'branch' && dragTarget.lecId === lec.id && dragTarget.bIdx === bIdx;

              const targetBX = lec.x + br.offX;
              const targetBY = lec.y + br.offY;

              if (!isDraggingThisBranch) {
                const bdx = targetBX - br.bx;
                const bdy = targetBY - br.by;
                const bax = bdx * 0.095;
                const bay = bdy * 0.095;

                br.vx = (br.vx + bax) * 0.83;
                br.vy = (br.vy + bay) * 0.83;

                if (Math.abs(br.vx) > 0.01 || Math.abs(br.vy) > 0.01 || Math.abs(bdx) > 0.1 || Math.abs(bdy) > 0.1) {
                  br.bx += br.vx;
                  br.by += br.vy;
                } else {
                  br.bx = targetBX;
                  br.by = targetBY;
                  br.vx = 0;
                  br.vy = 0;
                }
              }

              const bEl = domBranchNodes[bKey];
              if (bEl) {
                bEl.style.left = `${br.bx - 115}px`;
                bEl.style.top = `${br.by - 20}px`;
              }

              const bPath = domBranchWirePaths[bKey];
              if (bPath) {
                const relVx = (br.vx || 0) + (lec.vx || 0) * 0.6;
                const relVy = (br.vy || 0) + (lec.vy || 0) * 0.6;
                updateElasticWirePath(`br-${bKey}`, bPath, lec.x, lec.y, br.bx, br.by, relVx, relVy, false);
              }
            });
          }
        });
      }
      requestAnimationFrame(physicsTick);
    }

    function updateElasticWirePath(wireKey, pathEl, x1, y1, x2, y2, endVx, endVy, isHubWire) {
      let w = wireStateMap[wireKey];
      const idealX = (x1 + x2) * 0.5;
      const idealY = (y1 + y2) * 0.5 - (isHubWire ? 18 : 8);

      if (!w) {
        w = { cx: idealX, cy: idealY, vx: 0, vy: 0 };
        wireStateMap[wireKey] = w;
      }

      const dx = x2 - x1;
      const dy = y2 - y1;
      const len = Math.max(1, Math.hypot(dx, dy));
      const nx = -dy / len;
      const ny = dx / len;

      const speedCross = (endVx * nx + endVy * ny);
      const whipForceX = -endVx * 0.45 + nx * speedCross * 0.55;
      const whipForceY = -endVy * 0.45 + ny * speedCross * 0.55;

      const springK = isHubWire ? 0.13 : 0.15;
      const damping = isHubWire ? 0.77 : 0.75;

      const ax = (idealX - w.cx) * springK + whipForceX;
      const ay = (idealY - w.cy) * springK + whipForceY;

      w.vx = (w.vx + ax) * damping;
      w.vy = (w.vy + ay) * damping;
      w.cx += w.vx;
      w.cy += w.vy;

      pathEl.setAttribute('d', `M ${x1.toFixed(1)} ${y1.toFixed(1)} Q ${w.cx.toFixed(1)} ${w.cy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`);
    }

