    }

    function initBasketMinigame() {
      const canvas = document.getElementById('basket-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      const anchorX = 153;
      const anchorY = 275;
      const hoopX = 153;
      const hoopY = 112;
      const rimRadius = 27;

      const getCanvasPos = (clientX, clientY) => {
        const rect = canvas.getBoundingClientRect();
        return {
          x: (clientX - rect.left) * (canvas.width / rect.width),
          y: (clientY - rect.top) * (canvas.height / rect.height)
        };
      };

      const startPull = (clientX, clientY, e) => {
        if (!basketActive) return;
        const pos = getCanvasPos(clientX, clientY);
        if (bBall.state === 'flying' || bBall.state === 'post_shot') {
          resetBasketBall();
        }
        const dist = Math.hypot(pos.x - bBall.x, pos.y - bBall.y);
        if (dist <= 45) {
          e.stopPropagation();
          e.preventDefault();
          bBall.state = 'pulling';
          bBall.pullX = pos.x;
          bBall.pullY = pos.y;
        }
      };

      const movePull = (clientX, clientY) => {
        if (bBall.state !== 'pulling') return;
        const pos = getCanvasPos(clientX, clientY);
        // Clamp pull range so user pulls downward/backward like a slingshot
        const dx = pos.x - anchorX;
        const dy = Math.max(5, pos.y - (anchorY - 10));
        const maxPull = 62;
        const d = Math.hypot(dx, dy);
        if (d > maxPull) {
          bBall.pullX = anchorX + (dx / d) * maxPull;
          bBall.pullY = (anchorY - 10) + (dy / d) * maxPull;
        } else {
          bBall.pullX = anchorX + dx;
          bBall.pullY = (anchorY - 10) + dy;
        }
        bBall.x = bBall.pullX;
        bBall.y = bBall.pullY;
      };

      const releasePull = () => {
        if (bBall.state !== 'pulling') return;
        const pullDx = anchorX - bBall.pullX;
        const pullDy = anchorY - bBall.pullY;
        const pullPower = Math.hypot(pullDx, pullDy);

        if (pullPower < 8) {
          resetBasketBall();
          return;
        }

        // Launch forward toward the front-facing hoop with elastic power proportional to pull distance
        bBall.state = 'flying';
        bBall.vx = pullDx * 0.145;
        bBall.vy = -8.2 - (pullPower * 0.135);
        bBall.vz = 0.017 + (pullPower * 0.00022);
        bBall.vRot = pullDx * 0.02;
        bBall.scoredThisShot = false;
        bBall.enteredFromAbove = false;
      };

      canvas.addEventListener('mousedown', (e) => startPull(e.clientX, e.clientY, e));
      window.addEventListener('mousemove', (e) => movePull(e.clientX, e.clientY));
      window.addEventListener('mouseup', releasePull);

      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) startPull(e.touches[0].clientX, e.touches[0].clientY, e);
      }, { passive: false });
      window.addEventListener('touchmove', (e) => {
        if (bBall.state === 'pulling' && e.touches.length === 1) {
          e.preventDefault();
          movePull(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: false });
      window.addEventListener('touchend', releasePull);

      function stepBasketPhysics() {
        if (basketActive) {
          // Net spring physics
          const netAx = -netSway * 0.18;
          netSwayVel = (netSwayVel + netAx) * 0.85;
          netSway += netSwayVel;

          if (bBall.state === 'flying' || bBall.state === 'post_shot') {
            bBall.x += bBall.vx;
            bBall.y += bBall.vy;
            bBall.z += bBall.vz;
            bBall.vy += 0.34; // Gravity
            bBall.rot += bBall.vRot;

            // Track if ball rose above the hoop level on its arc
            if (bBall.y < hoopY - 12) {
              bBall.enteredFromAbove = true;
            }

            // Backboard collision at depth z >= 1.02
            if (bBall.z >= 1.02 && bBall.z <= 1.18 && Math.abs(bBall.x - hoopX) < 52 && bBall.y > 38 && bBall.y < 118 && bBall.vz > 0) {
              bBall.vz = -bBall.vz * 0.45;
              bBall.vy *= 0.78;
              bBall.vx *= 0.7;
            }

            // Rim plane interaction when descending near z = 0.85 .. 1.12 and y near hoopY
            if (bBall.enteredFromAbove && bBall.vy > 0 && Math.abs(bBall.y - hoopY) < 12 && bBall.z >= 0.78 && bBall.z <= 1.18) {
              const distToHoopCenter = Math.abs(bBall.x - hoopX);

              if (distToHoopCenter < rimRadius - 8 && !bBall.scoredThisShot) {
                // SWISH / GOAL!
                bBall.scoredThisShot = true;
                bBall.state = 'post_shot';
                bBall.vx *= 0.35;
                basketScore++;
                basketStreak++;
                document.getElementById('basket-score').textContent = basketScore;
                document.getElementById('basket-streak').textContent = basketStreak > 1 ? `🔥 Streak x${basketStreak}` : '';
                netSwayVel = (bBall.vx >= 0 ? 1 : -1) * 12 + 8;
                floatingPopups.push({
                  x: hoopX,
                  y: hoopY - 10,
                  text: distToHoopCenter < 8 ? 'SWISH! +1 🔥' : 'CANESTRO! +1 🏀',
                  alpha: 1.0
                });
              } else if (distToHoopCenter >= rimRadius - 8 && distToHoopCenter <= rimRadius + 10) {
                // Rim Iron Bounce!
                const rimPostX = bBall.x < hoopX ? (hoopX - rimRadius) : (hoopX + rimRadius);
                const bounceDx = bBall.x - rimPostX;
                bBall.vy = -Math.abs(bBall.vy) * 0.58;
                bBall.vx += bounceDx * 0.28;
                bBall.vRot = bounceDx * 0.05;
                netSwayVel += 3;
              }
            }

            // Reset when ball falls below floor
            if (bBall.y > 370 || bBall.x < -40 || bBall.x > 350) {
              if (!bBall.scoredThisShot) {
                basketStreak = 0;
                document.getElementById('basket-streak').textContent = '';
              }
              resetBasketBall();
            }
          }

          drawBasketScene(ctx, canvas.width, canvas.height, anchorX, anchorY, hoopX, hoopY, rimRadius);
        }
        requestAnimationFrame(stepBasketPhysics);
      }

      requestAnimationFrame(stepBasketPhysics);
    }

    function drawBasketScene(ctx, w, h, anchorX, anchorY, hoopX, hoopY, rimRadius) {
      ctx.clearRect(0, 0, w, h);

      // Court Perspective Lines
      ctx.strokeStyle = 'rgba(51, 65, 85, 0.35)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(hoopX, anchorY + 20, 115, Math.PI * 1.12, Math.PI * 1.88);
      ctx.stroke();

      // 1. Backboard (Front-facing glass backboard)
      ctx.fillStyle = 'rgba(30, 41, 59, 0.85)';
      ctx.strokeStyle = '#94a3b8';
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.roundRect(hoopX - 54, 38, 108, 76, 8);
      ctx.fill();
      ctx.stroke();

      // Backboard Shooter's Square
      ctx.strokeStyle = '#f97316';
      ctx.lineWidth = 2;
      ctx.strokeRect(hoopX - 20, 74, 40, 30);

      // BackRim Bracket
      ctx.fillStyle = '#ea580c';
      ctx.fillRect(hoopX - 6, 106, 12, 6);

      // Perspective scale of ball based on depth Z
      const ballScale = 1 / (1 + Math.max(0, bBall.z) * 0.55);
      const currentBallR = bBall.radius * ballScale;

      // If ball is behind the front rim (z > 0.95), draw ball before front rim & net
      const ballBehindFrontRim = bBall.z > 0.92;
      if (ballBehindFrontRim) {
        drawBasketballSprite(ctx, bBall.x, bBall.y, currentBallR, bBall.rot);
      }

      // 2. Dynamic Elastic Net
      ctx.strokeStyle = 'rgba(226, 232, 240, 0.85)';
      ctx.lineWidth = 1.4;
      const netBottomW = rimRadius * 0.62;
      const netHeight = 36;
      for (let i = -3; i <= 3; i++) {
        const topX = hoopX + (i / 3) * rimRadius;
        const botX = hoopX + (i / 3) * netBottomW + netSway * (1 - Math.abs(i) * 0.15);
        ctx.beginPath();
        ctx.moveTo(topX, hoopY);
        ctx.quadraticCurveTo((topX + botX) * 0.5 + netSway * 0.6, hoopY + netHeight * 0.55, botX, hoopY + netHeight);
        ctx.stroke();
      }
      // Horizontal net rings
      for (let r = 1; r <= 3; r++) {
        const t = r / 3.5;
        const yLevel = hoopY + netHeight * t;
        const halfW = rimRadius * (1 - t * 0.38);
        const swayOffset = netSway * t;
        ctx.beginPath();
        ctx.moveTo(hoopX - halfW + swayOffset, yLevel);
        ctx.lineTo(hoopX + halfW + swayOffset, yLevel);
        ctx.stroke();
      }

      // 3. Front Rim (Orange Iron Hoop)
      ctx.strokeStyle = '#f97316';
      ctx.lineWidth = 4.5;
      ctx.beginPath();
      ctx.ellipse(hoopX, hoopY, rimRadius, 6.5, 0, 0, Math.PI * 2);
      ctx.stroke();

      // 4. Slingshot Elastic Bands & Trajectory Preview when pulling
      if (bBall.state === 'pulling' || bBall.state === 'ready') {
        // Slingshot Anchor Posts
        ctx.fillStyle = '#475569';
        ctx.beginPath();
        ctx.arc(anchorX - 34, anchorY - 8, 4, 0, Math.PI * 2);
        ctx.arc(anchorX + 34, anchorY - 8, 4, 0, Math.PI * 2);
        ctx.fill();

        if (bBall.state === 'pulling') {
          const pullDist = Math.hypot(anchorX - bBall.pullX, anchorY - bBall.pullY);
          const tensionColor = pullDist > 42 ? '#f43f5e' : (pullDist > 22 ? '#f59e0b' : '#22d3ee');

          // Elastic Slingshot Cords
          ctx.strokeStyle = tensionColor;
          ctx.lineWidth = 2.5 + (pullDist / 28);
          ctx.beginPath();
          ctx.moveTo(anchorX - 34, anchorY - 8);
          ctx.lineTo(bBall.x, bBall.y);
          ctx.lineTo(anchorX + 34, anchorY - 8);
          ctx.stroke();

          // Trajectory Guide Dots
          const simVx = (anchorX - bBall.pullX) * 0.145;
          const simVy = -8.2 - (pullDist * 0.135);
          ctx.fillStyle = tensionColor;
          for (let step = 3; step <= 21; step += 3) {
            const px = bBall.x + simVx * step;
            const py = bBall.y + simVy * step + 0.5 * 0.34 * step * step;
            ctx.beginPath();
            ctx.arc(px, py, Math.max(1.5, 4 - step * 0.12), 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }

      // Draw ball in front if z <= 0.92
      if (!ballBehindFrontRim) {
        drawBasketballSprite(ctx, bBall.x, bBall.y, currentBallR, bBall.rot);
      }

      // Floating Score Popups
      for (let i = floatingPopups.length - 1; i >= 0; i--) {
        const p = floatingPopups[i];
        ctx.save();
        ctx.font = '800 13px Inter, sans-serif';
        ctx.fillStyle = `rgba(251, 191, 36, ${p.alpha})`;
        ctx.textAlign = 'center';
        ctx.fillText(p.text, p.x, p.y);
        ctx.restore();
        p.y -= 1.1;
        p.alpha -= 0.022;
        if (p.alpha <= 0) floatingPopups.splice(i, 1);
      }
    }

    function drawBasketballSprite(ctx, x, y, r, rot) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rot);

      const grad = ctx.createRadialGradient(-r * 0.3, -r * 0.3, r * 0.1, 0, 0, r);
      grad.addColorStop(0, '#fb923c');
      grad.addColorStop(0.7, '#ea580c');
      grad.addColorStop(1, '#9a3412');

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(0, 0, r, 0, Math.PI * 2);
      ctx.fill();

      // Basketball seams
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(-r, 0);
      ctx.lineTo(r, 0);
      ctx.moveTo(0, -r);
      ctx.lineTo(0, r);
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(-r * 0.65, 0, r * 0.7, -Math.PI * 0.38, Math.PI * 0.38);
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(r * 0.65, 0, r * 0.7, Math.PI * 0.62, Math.PI * 1.38);
      ctx.stroke();

      ctx.restore();
    }

