    function resetBasketBall() {
      bBall.x = 153;
      bBall.y = 275;
      bBall.z = 0;
      bBall.vx = 0;
      bBall.vy = 0;
      bBall.vz = 0;
      bBall.state = 'ready';
      bBall.pullX = 153;
      bBall.pullY = 275;
      bBall.scoredThisShot = false;
