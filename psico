    // ============================================================================
    // DOUBLE-CLICK INLINE TEXT EDITOR
    // ============================================================================
    function makeEditable(e, editType, id1, id2, id3) {
      e.stopPropagation();
      const el = e.currentTarget;
      el.contentEditable = "true";
      el.focus();

      const range = document.createRange();
      range.selectNodeContents(el);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);

      const finishEdit = () => {
        el.contentEditable = "false";
        const newVal = el.innerText.trim();
        if (!newVal) return;

        if (editType === 'lec-title') {
          const lec = lecturesData.find(l => l.id === id1);
          if (lec) lec.title = newVal;
        } else if (editType === 'lec-subtitle') {
          const lec = lecturesData.find(l => l.id === id1);
          if (lec) lec.subtitle = newVal;
        } else if (editType === 'lec-summary') {
          const lec = lecturesData.find(l => l.id === id1);
          if (lec) lec.summary = newVal;
        } else if (editType === 'branch-name') {
          const lec = lecturesData.find(l => l.id === id1);
          if (lec && lec.branches[id2]) lec.branches[id2].name = newVal;
        } else if (editType === 'branch-item') {
          const lec = lecturesData.find(l => l.id === id1);
          if (lec && lec.branches[id2]) lec.branches[id2].items[id3] = newVal;
        } else if (editType === 'prac-title') {
          const p = practicalsData[id1];
          if (p) p.title = newVal;
        } else if (editType === 'prep-name') {
          const p = practicalsData[id1];
          if (p && p.preparations[id2]) p.preparations[id2].name = newVal;
        } else if (editType === 'prep-tooth') {
          const p = practicalsData[id1];
          if (p && p.preparations[id2]) p.preparations[id2].tooth = newVal;
        } else if (editType === 'prep-burs') {
          const p = practicalsData[id1];
          if (p && p.preparations[id2]) p.preparations[id2].burSet = newVal;
        } else if (editType === 'step-stage') {
          const p = practicalsData[id1];
          if (p && p.preparations[id2] && p.preparations[id2].steps[id3]) {
            p.preparations[id2].steps[id3].stage = newVal;
          }
        } else if (editType === 'step-detail') {
          const p = practicalsData[id1];
          if (p && p.preparations[id2] && p.preparations[id2].steps[id3]) {
            p.preparations[id2].steps[id3].detail = newVal;
          }
        }

        saveAllData();
        renderLectureList(document.getElementById('global-search').value);
        renderConceptMap();
        renderInspector(selectedLectureId);
      };

      el.addEventListener('blur', finishEdit, { once: true });
      el.addEventListener('keydown', (ke) => {
        if (ke.key === 'Enter' && !ke.shiftKey) {
          ke.preventDefault();
          el.blur();
        }
      });
    }

