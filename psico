    // INTERNAL CRUD EDITOR
    // ============================================================================
    function addNewLecture() {
      const newId = lecturesData.length ? Math.max(...lecturesData.map(l => l.id)) + 1 : 1;
      const newX = hubX + (Math.random() > 0.5 ? 450 : -450);
      const newY = hubY + (Math.random() * 400 - 200);
      const defaultCluster = activeConfig.clusters?.[0]?.id || "foundations";
      const newLec = {
        id: newId,
        title: `Ch. ${newId}: Nuovo Argomento`,
        subtitle: "Doppio click per modificare",
        cluster: defaultCluster,
        color: "#06b6d4",
        x: newX, y: newY,
        restX: newX, restY: newY,
        vx: 15, vy: -10,
        summary: "Doppio click qui nell'Inspector per modificare il riassunto di questo capitolo.",
        branches: [
          {
            name: "Nuova Branch 1",
            offX: 270, offY: 0,
            bx: newX + 270, by: newY,
            vx: 20, vy: 0,
            items: ["Doppio click per modificare questo punto."]
          }
        ]
      };
      lecturesData.push(newLec);
      expandedBranches.add(newId);
      expandedLeafBranches.add(`${newId}-0`);
      saveAllData();
      updateProgressBadge();
      selectLecture(newId, true);
