    function deleteLecture(lecId) {
      if (lecturesData.length <= 1) return;
      if (!confirm("Vuoi eliminare questo capitolo?")) return;
      lecturesData = lecturesData.filter(l => l.id !== lecId);
      selectedLectureId = lecturesData[0].id;
      saveAllData();
      updateProgressBadge();
      renderLectureList();
      renderConceptMap();
      renderInspector(selectedLectureId);
    }

    function addBranchToLecture(e, lecId) {
      if (e) e.stopPropagation();
      const lec = lecturesData.find(l => l.id === lecId);
      if (!lec) return;
      const dir = lec.x < hubX ? -1 : 1;
      const bIdx = lec.branches.length;
      const offX = dir * 280;
      const offY = (bIdx - 1) * 75;
      lec.branches.push({
        name: `Nuova Branch ${bIdx + 1}`,
        offX: offX,
        offY: offY,
        bx: lec.x + offX * 0.4,
        by: lec.y + offY * 0.4,
        vx: dir * 18,
        vy: 8,
        items: ["Nuovo concetto chiave (doppio click per modificare)"]
      });
      expandedBranches.add(lecId);
      expandedLeafBranches.add(`${lecId}-${bIdx}`);
      saveAllData();
      renderConceptMap();
      renderInspector(lecId);
    }

    function deleteBranch(lecId, bIdx) {
      const lec = lecturesData.find(l => l.id === lecId);
      if (!lec) return;
      lec.branches.splice(bIdx, 1);
      saveAllData();
      renderConceptMap();
      renderInspector(lecId);
    }

    function addPointToBranch(e, lecId, bIdx) {
      if (e) e.stopPropagation();
      const lec = lecturesData.find(l => l.id === lecId);
      if (!lec || !lec.branches[bIdx]) return;
      lec.branches[bIdx].items.push("Nuovo dettaglio: doppio click per modificare il testo.");
      expandedLeafBranches.add(`${lecId}-${bIdx}`);
      saveAllData();
      renderConceptMap();
      renderInspector(lecId);
    }

    function deletePointFromBranch(e, lecId, bIdx, iIdx) {
      if (e) e.stopPropagation();
      const lec = lecturesData.find(l => l.id === lecId);
      if (!lec || !lec.branches[bIdx]) return;
      lec.branches[bIdx].items.splice(iIdx, 1);
      saveAllData();
      renderConceptMap();
      renderInspector(lecId);
    }

